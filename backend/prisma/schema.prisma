// Konfiguracja generatora klienta (dla TypeScriptu)
generator client {
  provider = "prisma-client-js"
}

// Konfiguracja połączenia z bazą (czyta z Twojego pliku .env)
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- NASZE TABELE W BAZIE DANYCH ---

// Tabela Projektów (Punkt 3.2 z briefu)
model Job {
  jobNumber  String      @id // Np. "JOB-001" będzie naszym kluczem głównym
  title      String
  status     String      @default("active")
  
  // Relacja: Jeden projekt może mieć wiele wpisów (timesheetów)
  timesheets Timesheet[] 
}

// Tabela Wpisów Czasu Pracy (Punkt 3.1 z briefu)
model Timesheet {
  id             String   @id @default(uuid()) // Unikalne ID generowane automatycznie
  idempotencyKey String   @unique // Klucz zabezpieczający przed podwójnym zapisem
  
  // Relacja do tabeli Job (łączymy po numerze projektu np. JOB-001)
  jobNumber      String
  job            Job      @relation(fields: [jobNumber], references: [jobNumber])
  
  // Dane wyciągane przez asystenta AI
  date           String
  hours          Float
  taskType       String?  // Znak zapytania oznacza, że pole jest opcjonalne (może być null)
  billable       Boolean?
  description    String?  @db.Text // @db.Text pozwala na dłuższe opisy
  
  createdAt      DateTime @default(now())
}